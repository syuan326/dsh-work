{
  "name": "@local/dsh-split-mail",
  "version": "1.0.0",
  "private": true,
  "description": "Personal and work mail with isolated preset tools and DSH-native analysis",
  "type": "module",
  "exports": {
    ".": "./index.mjs",
    "./client": "./client.js",
    "./personal-tools": "./personal-tools.mjs",
    "./work-tools": "./work-tools.mjs",
    "./personal-tools/icon": "./icon.svg",
    "./work-tools/icon": "./icon.svg",
    "./personal-tools/locale/*.json": "./locale/*.json",
    "./work-tools/locale/*.json": "./locale/*.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": ["*.mjs", "client.js", "cordis.patch.yml", "locale", "docs", "icon.svg", "README.md"],
  "scripts": { "test": "node --test test/*.test.mjs" },
  "dependencies": { "imapflow": "^1.0.0", "mailparser": "^3.7.0", "nodemailer": "^7.0.0", "zod": "^4.0.0" },
  "engines": { "node": ">=22", "dsh": "0.2.2-rc.3" },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": { "platform": "web", "immediately": true, "inject": ["@deepseek-ai/dsh-client-ui-sidebar", "@deepseek-ai/dsh-client-ui-layout", "@deepseek-ai/dsh-client-ui-settings"] }
  }
}
